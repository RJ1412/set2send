generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  name                 String
  password_hash        String?
  google_id            String?   @unique
  plan                 String    @default("free")
  razorpay_customer_id String?
  trial_ends_at        DateTime?
  created_at           DateTime  @default(now())

  // S2S Coins + Referral
  referral_code    String? @unique // auto-generated on signup, nullable for existing rows
  referred_by_code String? // nullable, set once at signup, immutable
  is_admin         Boolean @default(false)

  instagram_accounts  InstagramAccount[]
  whatsapp_accounts   WhatsappAccount[]
  subscription        Subscription?
  alert_config        AlertConfig?
  whatsapp_campaigns  WhatsappCampaign[]
  leads               Lead[]
  analytics_snapshots AnalyticsSnapshot[]
  suggestion_log      SuggestionLog?
  coin_ledger_entries CoinLedger[]
  payout_requests     PayoutRequest[]
  coin_reservations   CoinReservation[]
  referrals_made      Referral[]          @relation("ReferrerRelation")
  referral_received   Referral?           @relation("ReferredRelation")

  @@map("users")
}

model InstagramAccount {
  id               String    @id @default(uuid())
  user_id          String
  ig_user_id       String    @unique
  ig_username      String
  access_token     String
  token_expires_at DateTime?
  status           String    @default("active")
  connected_at     DateTime  @default(now())

  user      User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  contacts  InstagramContact[]

  @@map("instagram_accounts")
}

model InstagramContact {
  id                   String    @id @default(uuid())
  instagram_account_id String
  username             String
  messaging_ig_id      String
  first_name           String?
  last_name            String?
  email                String?
  city                 String?
  source               String    @default("manual") // comment, story_reply, story_mention, whatsapp, manual
  engagement_score     Int       @default(0)
  sequence_status      String    @default("not_started") // not_started, active, completed, opted_out
  last_active_at       DateTime?

  // Cross-DM Sequence (Feature 7)
  whatsapp_number    String?
  whatsapp_opted_in  Boolean   @default(false)
  whatsapp_opt_in_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  instagram_account InstagramAccount @relation(fields: [instagram_account_id], references: [id], onDelete: Cascade)
  tags              ContactTag[]

  @@unique([instagram_account_id, username])
  @@map("instagram_contacts")
}

model WhatsappAccount {
  id                 String   @id @default(uuid())
  user_id            String
  wa_phone_number_id String   @unique
  wa_phone_number    String
  status             String   @default("active")
  connected_at       DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("whatsapp_accounts")
}

model ContactTag {
  id         String   @id @default(uuid())
  contact_id String
  tag_name   String
  created_at DateTime @default(now())

  contact InstagramContact @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  @@unique([contact_id, tag_name])
  @@map("contact_tags")
}

model Campaign {
  id                   String   @id @default(uuid())
  instagram_account_id String
  ig_media_id          String?
  ig_media_url         String?
  trigger_type         String   @default("comment") // comment, story_mention
  keyword              String
  fuzzy_match          Boolean  @default(false)
  dm_template          String
  public_reply_text    String?
  public_reply_enabled Boolean  @default(false)
  status               String   @default("active")
  dms_sent             Int      @default(0)
  created_at           DateTime @default(now())

  // Follow Gate
  require_follow        Boolean @default(false)
  follow_message        String?
  not_following_message String?
  follow_gate_count     Int     @default(0)

  // Email Collection
  collect_email        Boolean @default(false)
  email_prompt_message String?

  // Follow-up
  follow_up_message    String?
  follow_up_time_hours Int?
  follow_ups_sent      Int     @default(0)

  // Re-trigger
  retrigger_mode        String  @default("never") // always, never, after_days
  retrigger_days        Int?
  returning_dm_template String?

  // Scarcity Gate (Feature 6)
  limit_enabled         Boolean @default(false)
  limit_count           Int?
  limit_reached_message String?

  // Media & Link Attachments
  attachment_type String? // 'image', 'video', 'link', 'none'
  attachment_url  String?
  link_url        String?
  link_title      String?

  instagram_account InstagramAccount @relation(fields: [instagram_account_id], references: [id], onDelete: Cascade)
  dm_logs           DmLog[]
  collected_emails  CollectedEmail[]
  link_clicks       LinkClick[]
  follow_jobs       FollowGateJob[]
  analytics_events  AnalyticsEvent[]

  @@map("campaigns")
}

model CollectedEmail {
  id                 String   @id @default(uuid())
  campaign_id        String
  commenter_username String
  email              String
  created_at         DateTime @default(now())

  campaign Campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@map("collected_emails")
}

model LinkClick {
  id              String   @id @default(uuid())
  campaign_id     String
  commenter_ig_id String
  source          String // "original" or "follow_up"
  clicked_at      DateTime @default(now())

  campaign Campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@map("link_clicks")
}

model FollowGateJob {
  id                    String    @id @default(uuid())
  campaign_id           String
  commenter_ig_id       String
  commenter_username    String
  comment_text          String
  comment_id            String
  messaging_ig_id       String? // Populated when we map them or they reply
  status                String    @default("pending_follow")
  follow_prompt_sent_at DateTime?
  delivered_at          DateTime?
  analytics_flag        String?
  notes                 String?
  created_at            DateTime  @default(now())

  campaign Campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@map("follow_gate_jobs")
}

model DmLog {
  id                 String    @id @default(uuid())
  campaign_id        String
  commenter_ig_id    String
  commenter_username String
  comment_text       String
  comment_id         String
  dm_status          String
  error_message      String?
  commented_at       DateTime
  dm_sent_at         DateTime?

  campaign Campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@map("dm_logs")
}

model AnalyticsEvent {
  id                 String   @id @default(uuid())
  campaign_id        String
  event_name         String // dm_sent, dm_opened, dm_replied, story_mention
  commenter_username String
  created_at         DateTime @default(now())

  campaign Campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@map("analytics_events")
}

model AlertConfig {
  id                     String  @id @default(uuid())
  user_id                String  @unique
  whatsapp_number        String?
  alert_email            String?
  token_expiry_alert     Boolean @default(true)
  automation_break_alert Boolean @default(true)
  daily_summary          Boolean @default(false)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("alert_configs")
}

model Subscription {
  id                 String    @id @default(uuid())
  user_id            String    @unique
  plan               String // free / creator / growth / biz
  plan_key           String    @default("free") // canonical plan key
  razorpay_sub_id    String? // Razorpay subscription ID
  razorpay_order_id  String? // last order ID
  status             String    @default("active") // active / cancelled / past_due
  purchased_addons   String? // JSON array of addon keys e.g. ["crm","wa"]
  extra_ig_accounts  Int       @default(0)
  extra_wa_accounts  Int       @default(0)
  current_period_end DateTime?
  first_paid_at      DateTime? // timestamp of first successful paid charge
  created_at         DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model WhatsappCampaign {
  id              String        @id @default(cuid())
  userId          String
  name            String
  messageType     String // "template" | "freeform"
  templateName    String?
  templateParams  String? // array of strings for {{1}}, {{2}} variables
  freeformBody    String?
  status          String        @default("draft") // draft | running | completed | failed
  totalRecipients Int           @default(0)
  sentCount       Int           @default(0)
  failedCount     Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id])
  logs            WhatsappLog[]
}

model WhatsappLog {
  id           String           @id @default(cuid())
  campaignId   String
  phone        String
  name         String?
  status       String           @default("queued") // queued|sent|failed|delivered|read
  waMessageId  String?
  errorCode    String?
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime         @default(now())
  campaign     WhatsappCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Flow {
  id         String   @id @default(uuid())
  account_id String
  name       String   @default("Untitled Flow")
  status     String   @default("draft") // active, draft, paused
  nodes      String?  @default("[]")
  edges      String?  @default("[]")
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  leads      Lead[]

  @@map("flows")
}

model BioPage {
  id               String      @id @default(uuid())
  account_id       String
  slug             String      @unique
  background_color String?
  logo_url         String?
  created_at       DateTime    @default(now())
  buttons          BioButton[]

  @@map("bio_pages")
}

model BioButton {
  id            String  @id @default(uuid())
  bio_page_id   String
  label         String
  icon          String?
  sort_order    Int     @default(0)
  is_active     Boolean @default(true)
  action_type   String // external_link, dm_trigger, whatsapp_trigger
  action_config String?

  bio_page BioPage @relation(fields: [bio_page_id], references: [id], onDelete: Cascade)

  @@map("bio_buttons")
}

model FlowTemplate {
  id                String   @id @default(uuid())
  title             String
  description       String?
  niche             String?
  use_case          String?
  author_account_id String
  flow_definition   String
  is_public         Boolean  @default(false)
  price             Int      @default(0)
  install_count     Int      @default(0)
  created_at        DateTime @default(now())

  @@map("flow_templates")
}

model Lead {
  id             String  @id @default(cuid())
  userId         String
  instagramId    String?
  whatsappNumber String?
  username       String?
  fullName       String?
  profilePicUrl  String?
  email          String?
  phone          String?
  bio            String?
  followerCount  Int?
  isFollower     Boolean @default(false)

  score Int    @default(0)
  stage String @default("cold")

  tags       LeadTag[]
  activities LeadActivity[]
  notes      LeadNote[]

  sourceFlowId  String?
  sourcePostId  String?
  sourceTrigger String?

  dmsSent       Int     @default(0)
  dmsOpened     Int     @default(0)
  linksClicked  Int     @default(0)
  repliesGiven  Int     @default(0)
  emailCaptured Boolean @default(false)

  lastActivityAt DateTime?
  convertedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User  @relation(fields: [userId], references: [id])
  flow Flow? @relation(fields: [sourceFlowId], references: [id])
}

model LeadTag {
  id        String   @id @default(cuid())
  leadId    String
  name      String
  color     String   @default("#E84B1E")
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  metadata  String?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  content   String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model AnalyticsSnapshot {
  id     String   @id @default(cuid())
  userId String
  date   DateTime

  totalLeads     Int @default(0)
  newLeads       Int @default(0)
  dmsSent        Int @default(0)
  dmsOpened      Int @default(0)
  linksClicked   Int @default(0)
  emailsCaptured Int @default(0)
  conversions    Int @default(0)
  followBacks    Int @default(0)

  openRate         Float @default(0)
  clickRate        Float @default(0)
  emailCaptureRate Float @default(0)
  conversionRate   Float @default(0)

  topFlowId String?
  topPostId String?

  coldCount      Int @default(0)
  warmCount      Int @default(0)
  hotCount       Int @default(0)
  convertedCount Int @default(0)

  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model SuggestionLog {
  id          String   @id @default(cuid())
  userId      String
  suggestions String
  generatedAt DateTime @default(now())
  expiresAt   DateTime
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId])
}

// Replaces Redis email_prompt keys — tracks pending email collection state
model EmailPrompt {
  id           String   @id @default(cuid())
  ig_user_id   String // our IG account (recipientId)
  sender_ig_id String // the commenter's IG ID (senderId)
  campaign_id  String
  createdAt    DateTime @default(now())
  expiresAt    DateTime // set to 24h from now

  @@unique([ig_user_id, sender_ig_id])
}

// Replaces Redis processed_* keys — deduplication for webhook events
model ProcessedEvent {
  id        String   @id @default(cuid())
  event_key String   @unique
  createdAt DateTime @default(now())
}

// ── S2S COINS SYSTEM ──

// Append-only ledger — balance is always SUM(delta) per user
model CoinLedger {
  id            String   @id @default(cuid())
  user_id       String
  delta         Int // positive = credit, negative = debit
  reason        String // referral_bonus_referrer | referral_bonus_referee | applied_to_invoice | redeemed_cash | admin_adjustment
  reference_id  String? // e.g. order_id, payout_request_id, referral_id
  balance_after Int // snapshot of balance after this entry
  created_at    DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("coin_ledger")
}

// Tracks referrer-to-referred relationships
model Referral {
  id                     String    @id @default(cuid())
  referrer_id            String // user who shared the code
  referred_user_id       String    @unique // user who used the code (unique — one referral per user)
  status                 String    @default("pending") // pending | converted | rewarded | flagged
  converted_at           DateTime? // when first paid charge happened
  reward_txn_referrer_id String? // CoinLedger.id for referrer reward
  reward_txn_referee_id  String? // CoinLedger.id for referee reward
  flagged_reason         String? // reason for flagging (self-referral/suspicious)
  created_at             DateTime  @default(now())

  referrer      User @relation("ReferrerRelation", fields: [referrer_id], references: [id], onDelete: Cascade)
  referred_user User @relation("ReferredRelation", fields: [referred_user_id], references: [id], onDelete: Cascade)

  @@index([referrer_id])
  @@map("referrals")
}

// Redemption requests — manual admin approval only
model PayoutRequest {
  id           String    @id @default(cuid())
  user_id      String
  coin_amount  Int // coins being redeemed
  inr_amount   Int // INR equivalent (= coin_amount × 1)
  bank_details String? // JSON: account_number, ifsc, account_name, bank_name
  status       String    @default("pending") // pending | approved | rejected | paid
  requested_at DateTime  @default(now())
  processed_at DateTime?
  processed_by String? // admin user_id
  admin_note   String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
  @@map("payout_requests")
}

// Pending coin deductions tied to a Razorpay order (released on failure)
model CoinReservation {
  id          String   @id @default(cuid())
  user_id     String
  order_id    String   @unique // Razorpay order_id
  coin_amount Int
  status      String   @default("pending") // pending | finalized | released
  created_at  DateTime @default(now())
  expires_at  DateTime // order expiry time

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("coin_reservations")
}

// Razorpay webhook event deduplication
model WebhookEvent {
  id           String   @id @default(cuid())
  event_id     String   @unique // Razorpay event.id (x-razorpay-event-id header)
  event_type   String // e.g. payment.captured
  processed_at DateTime @default(now())

  @@map("webhook_events")
}

model OtpVerification {
  id         String   @id @default(cuid())
  email      String   @unique
  otp        String
  expires_at DateTime
  created_at DateTime @default(now())

  @@map("otp_verifications")
}
